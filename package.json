{
  "name": "eventpass-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"tsx watch server/dev.ts\"",
    "build": "next build --webpack",
    "start": "concurrently -k \"next start\" \"tsx server/dev.ts\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "auth:dev": "node --env-file=server/auth/.env --import tsx server/auth/dev.ts",
    "portal:dev": "node --env-file=apps/member-portal/.env --import tsx apps/member-portal/dev.ts",
    "membership": "node --env-file=server/auth/.env --import tsx scripts/membership.ts",
    "demo:dev": "next dev",
    "auth:setup": "node --import tsx scripts/setup-auth.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/supabase-js": "^2.0.0",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serverless-http": "^3.2.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^6.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
