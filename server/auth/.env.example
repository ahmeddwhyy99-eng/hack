AUTH_ORIGIN=http://localhost:3001
RP_ORIGIN=http://localhost:4000
AUTH_CLIENT_ID=memberspace
# Generate a random 32-byte secret; use the same value in the portal environment.
AUTH_CLIENT_SECRET=
# Local database is created and migrated automatically. Never put it in public/.
AUTH_STORE=sqlite
AUTH_DB_PATH=.data/auth.sqlite
# Alternatively run supabase/auth-schema.sql and set BOTH server-only values:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
